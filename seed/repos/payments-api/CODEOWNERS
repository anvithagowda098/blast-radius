*                    @acme/payments-team
/package.json        @devon-pay

# The next three lines are invalid in CODEOWNERS, so GitHub skips them:
# negation (!), character ranges ([ ]), and an owner that isn't @user,
# @org/team or an email.
!/legacy/            @acme/payments-team
/docs/[ab]*.md       @acme/docs
/infra/              not-a-valid-owner
